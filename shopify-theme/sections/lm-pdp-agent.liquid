{%- comment -%}
  Agent-optimized Product Detail Page.
  Server-rendered, no JS, no CSS. Optimized for LLM crawlers and agent commerce.
  Brand: Send From China
  Conditional rendering: editorial content only shown when metafields exist.
{%- endcomment -%}

{%- assign current_variant = product.selected_or_first_available_variant -%}

{%- comment -%}
  Honest availability signal.
  Every SKU is oversell (CONTINUE, no real-time stock truth) and fulfilment is
  cross-border made-to-order. Asserting schema.org/InStock by default is a FALSE
  signal: agents that hit MERCHANDISE_NOT_AVAILABLE at checkout de-rank/ban the
  merchant (the #1 trust failure). So:
    - Shopify marks the variant unavailable  -> OutOfStock
    - real supplier-stock signal present      -> InStock   (wpai.supplier_in_stock = true)
    - otherwise (purchasable via oversell)    -> BackOrder (ships after cross-border lead time)
  Flip a SKU to InStock by setting the boolean metafield once real stock tracking
  exists. Absent metafield = falsy = BackOrder, which is the honest default today.
{%- endcomment -%}
{%- assign wp_supplier_in_stock = product.metafields.wpai.supplier_in_stock.value -%}

{%- comment -%}
  UTM scheme for AI-agent traffic attribution.
  Lets Shopify Analytics + GA4 + Google Search Console distinguish:
    - what came from agent_view (AI surface) vs to-C (human surface)
    - which template surface (pdp vs variant vs collection_list)
  When we know the agent (Custom GPT / Claude / Perplexity), populate utm_campaign accordingly.
{%- endcomment -%}
{%- assign utm_pdp      = 'utm_source=ai_agent&utm_medium=agent_view&utm_campaign=sendfromchina_agent&utm_content=pdp' -%}
{%- assign utm_variant  = 'utm_source=ai_agent&utm_medium=agent_view&utm_campaign=sendfromchina_agent&utm_content=pdp_variant' -%}

{%- assign cart_url = shop.url | append: '/cart/' | append: current_variant.id | append: ':1?' | append: utm_pdp -%}

{%- comment -%} Enhanced Product JSON-LD {%- endcomment -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org/",
  "@type": "Product",
  "name": {{ product.title | json }},
  "description": {{ product.description | strip_html | truncate: 5000 | json }},
  "url": {{ canonical_url | json }},
  "sku": {{ current_variant.sku | json }},
  "mpn": {{ current_variant.sku | json }},
  "brand": {
    "@type": "Brand",
    "name": "Send From China"
  },
  "image": [
    {%- for image in product.images limit: 20 -%}
      {
        "@type": "ImageObject",
        "url": {{ image | image_url: width: 1200 | json }},
        "thumbnailUrl": {{ image | image_url: width: 400 | json }},
        "width": {{ image.width | default: 1200 }},
        "height": {{ image.height | default: 1200 }},
        "name": {{ image.alt | default: product.metafields.wpai.alt_caption.value | default: product.title | json }},
        "caption": {{ image.alt | default: product.metafields.wpai.alt_caption.value | default: product.title | json }},
        "position": {{ forloop.index }}
      }{%- unless forloop.last -%},{%- endunless -%}
    {%- endfor -%}
  ]
  {%- if product.metafields.custom.colour != blank -%},
  "color": {{ product.metafields.custom.colour | json }}
  {%- endif -%}
  {%- if product.metafields.custom.material != blank -%},
  "material": {{ product.metafields.custom.material | json }}
  {%- endif -%}
  {%- if product.metafields.custom.country_of_origin != blank -%},
  "countryOfOrigin": {
    "@type": "Country",
    "name": {{ product.metafields.custom.country_of_origin | json }}
  }
  {%- endif -%}
  {%- if current_variant.weight > 0 -%},
  "weight": {
    "@type": "QuantitativeValue",
    "value": {{ current_variant.weight | json }},
    "unitCode": "{%- case current_variant.weight_unit -%}{%- when 'g' -%}GRM{%- when 'kg' -%}KGM{%- when 'oz' -%}ONZ{%- when 'lb' -%}LBR{%- else -%}GRM{%- endcase -%}"
  }
  {%- endif -%}
  ,
  {%- if product.variants.size > 1 -%}
  "offers": [
    {%- for v in product.variants -%}
    {
      "@type": "Offer",
      "sku": {{ v.sku | json }},
      "name": {{ v.title | json }},
      "url": "{{ shop.url }}/cart/{{ v.id }}:1?{{ utm_variant }}",
      "price": "{{ v.price | divided_by: 100.0 }}",
      "priceCurrency": {{ cart.currency.iso_code | json }},
      "availability": "https://schema.org/{%- if v.available == false -%}OutOfStock{%- elsif wp_supplier_in_stock -%}InStock{%- else -%}BackOrder{%- endif -%}",
      "itemCondition": "https://schema.org/NewCondition"
    }{%- unless forloop.last -%},{%- endunless -%}
    {%- endfor -%}
  ]
  {%- else -%}
  "offers": {
    "@type": "Offer",
    "url": {{ cart_url | json }},
    "price": "{{ current_variant.price | divided_by: 100.0 }}",
    "priceCurrency": {{ cart.currency.iso_code | json }},
    "availability": "https://schema.org/{%- if current_variant.available == false -%}OutOfStock{%- elsif wp_supplier_in_stock -%}InStock{%- else -%}BackOrder{%- endif -%}",
    "itemCondition": "https://schema.org/NewCondition",
    "seller": {
      "@type": "Organization",
      "name": "Send From China"
    }
  }
  {%- endif -%}
}
</script>

{%- comment -%}
  FAQPage JSON-LD — machine-readable Q&A agents quote when answering buyer
  questions and building comparisons (wpai.faq, generated text-only by the
  governance worker). Renders only when real Q&A exists.
{%- endcomment -%}
{%- assign wp_faq = product.metafields.wpai.faq.value -%}
{%- if wp_faq and wp_faq.size > 0 -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org/",
  "@type": "FAQPage",
  "mainEntity": [
    {%- for item in wp_faq -%}
    {
      "@type": "Question",
      "name": {{ item.q | json }},
      "acceptedAnswer": { "@type": "Answer", "text": {{ item.a | json }} }
    }{%- unless forloop.last -%},{%- endunless -%}
    {%- endfor -%}
  ]
}
</script>
{%- endif -%}

<h1>{{ product.title }}</h1>

<p>
<strong>Brand:</strong> Send From China<br>
{%- if product.variants.size > 1 -%}
<strong>This product has {{ product.variants.size }} variants (SKUs).</strong> Default shown below; full list under &ldquo;Available Variants&rdquo;.<br>
<strong>Price range:</strong> {{ product.price_min | money }}{%- unless product.price_min == product.price_max %} &ndash; {{ product.price_max | money }}{%- endunless -%}<br>
<strong>Default variant:</strong> {{ current_variant.title }}<br>
<strong>Default SKU:</strong> {{ current_variant.sku | default: product.id }}<br>
<strong>Default price:</strong> {{ current_variant.price | money }}
{%- if current_variant.compare_at_price > current_variant.price -%}&nbsp;(was {{ current_variant.compare_at_price | money }}){%- endif -%}<br>
{%- else -%}
<strong>SKU:</strong> {{ current_variant.sku | default: product.id }}<br>
<strong>Price:</strong> {{ current_variant.price | money }}
{%- if current_variant.compare_at_price > current_variant.price -%}&nbsp;(was {{ current_variant.compare_at_price | money }}){%- endif -%}<br>
{%- endif -%}
<strong>Availability:</strong> {% if current_variant.available == false %}Out of Stock{% elsif wp_supplier_in_stock %}In Stock{% else %}Made to order (cross-border) &mdash; ships from China; see &ldquo;Live Shipping Rates&rdquo; below for delivery estimate{% endif %}<br>
{%- if product.type != blank -%}<strong>Product Type:</strong> {{ product.type }}<br>{%- endif -%}
{%- if product.vendor != blank -%}<strong>Vendor:</strong> {{ product.vendor }}<br>{%- endif -%}
{%- if current_variant.weight > 0 -%}<strong>Weight:</strong> {{ current_variant.weight }} {{ current_variant.weight_unit }}<br>{%- endif -%}
{%- if product.metafields.custom.country_of_origin != blank -%}<strong>Country of Origin:</strong> {{ product.metafields.custom.country_of_origin }}<br>{%- endif -%}
<strong>Cart URL (default variant):</strong> <a href="{{ cart_url }}">{{ cart_url }}</a><br>
<strong>Human view:</strong> <a href="{{ canonical_url }}">{{ canonical_url }}</a><br>
<strong>JSON data:</strong> <a href="{{ canonical_url }}.json">{{ canonical_url }}.json</a>
</p>

{%- comment -%} Variants moved up — placed adjacent to Price so agents reading top-down see SKU options before description. {%- endcomment -%}
