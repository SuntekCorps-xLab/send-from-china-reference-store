{%- comment -%}
  Images section — only renders images that have AI-generated vision descriptions
  (product.metafields.ai_vision.image_desc_N). Other images remain available
  to agents via the Product JSON-LD image[] array above.
{%- endcomment -%}
{%- if product.images.size > 0 -%}

{%- comment -%} Count how many images have AI descriptions {%- endcomment -%}
{%- assign described_count = 0 -%}
{%- for image in product.images -%}
  {%- assign key = 'image_desc_' | append: forloop.index -%}
  {%- if product.metafields.ai_vision[key] != blank -%}
    {%- assign described_count = described_count | plus: 1 -%}
  {%- endif -%}
{%- endfor -%}

<h2>Images</h2>
<p>
This product has {{ product.images.size }} image{%- if product.images.size > 1 -%}s{%- endif -%} in catalog.
{%- if described_count > 0 -%}
Showing {{ described_count }} with AI-generated visual description{%- if described_count > 1 -%}s{%- endif -%} below.
All {{ product.images.size }} image URLs are included in the Product JSON-LD above, so agents that need full visual access can fetch any of them directly.
{%- else -%}
None have AI-generated visual descriptions yet. All image URLs are in the Product JSON-LD above.
{%- endif -%}
</p>

{%- for image in product.images -%}
  {%- assign ai_desc_key = 'image_desc_' | append: forloop.index -%}
  {%- assign ai_desc = product.metafields.ai_vision[ai_desc_key] -%}
  {%- if ai_desc == blank -%}{%- continue -%}{%- endif -%}

<h3>Image {{ forloop.index }}{%- if image.alt != blank %}: {{ image.alt }}{%- endif -%}</h3>
<ul>
<li><strong>Alt text:</strong> {%- if image.alt != blank -%}{{ image.alt }}{%- else -%}<em>(not provided)</em>{%- endif -%}</li>
<li><strong>Dimensions:</strong> {{ image.width | default: '?' }}&times;{{ image.height | default: '?' }} px (aspect ratio {{ image.aspect_ratio | default: 1 | times: 100.0 | divided_by: 100.0 }})</li>
<li><strong>Position in gallery:</strong> {{ forloop.index }} of {{ product.images.size }}</li>
<li><strong>Main URL (1200w):</strong> <a href="{{ image | image_url: width: 1200 }}">{{ image | image_url: width: 1200 }}</a></li>
<li><strong>Medium URL (800w):</strong> <a href="{{ image | image_url: width: 800 }}">{{ image | image_url: width: 800 }}</a></li>
<li><strong>Thumb URL (400w):</strong> <a href="{{ image | image_url: width: 400 }}">{{ image | image_url: width: 400 }}</a></li>
<li><strong>AI-generated visual description:</strong>
<pre style="white-space:pre-wrap;font-family:inherit;margin:0">{{ ai_desc }}</pre>
</li>
</ul>
{%- endfor -%}
{%- endif -%}

{%- comment -%} Server-rendered Specifications from metafields {%- endcomment -%}
{%- assign has_custom_specs = false -%}
{%- if product.metafields.custom.material != blank or product.metafields.custom.colour != blank or product.metafields.custom.craft_technique != blank or product.metafields.custom.country_of_origin != blank or product.metafields.custom.product_highlights != blank -%}
