&nbsp;&nbsp;Price: {{ v.price | money }}{%- if v.compare_at_price > v.price %} (was {{ v.compare_at_price | money }}){%- endif -%}<br>
&nbsp;&nbsp;Availability: {%- if v.available == false -%}Out of Stock{%- elsif wp_supplier_in_stock -%}In Stock{%- else -%}Made to order (cross-border){%- endif -%}<br>
{%- if v.weight > 0 -%}&nbsp;&nbsp;Weight: {{ v.weight }} {{ v.weight_unit }}<br>{%- endif -%}
&nbsp;&nbsp;Cart URL: <a href="{{ shop.url }}/cart/{{ v.id }}:1?{{ utm_variant }}">{{ shop.url }}/cart/{{ v.id }}:1</a>
</li>
{%- endfor -%}
</ul>
{%- endunless -%}

<h2>Description</h2>
{{ product.description }}

{%- comment -%} Common Questions — human-readable mirror of the FAQPage JSON-LD above. {%- endcomment -%}
