<meta charset="utf-8">
<meta
  http-equiv="X-UA-Compatible"
  content="IE=edge"
>
<meta
  name="viewport"
  content="width=device-width,initial-scale=1"
>
<meta
  name="view-transition"
  content="same-origin"
>
<meta
  name="theme-color"
  content=""
>

{%- comment -%}
  Agent-view alternate link.
  Tells AI crawlers / agent clients that an agent-optimized version of this
  product/collection page is available at ?view=agent.
{%- endcomment -%}
{%- if request.page_type == 'product' or request.page_type == 'collection' or request.page_type == 'index' or request.page_type == 'search' -%}
<link
  rel="alternate"
  type="text/html"
  href="{{ canonical_url }}?view=agent"
  title="Agent-optimized view"
>
{%- endif -%}
{%- liquid
  assign public_brand = 'Send From China'
  assign og_title = page_title | default: public_brand
  assign og_url = canonical_url | default: request.origin
  assign og_type = 'website'
  assign og_description = page_description | default: shop.description | default: public_brand

  if request.page_type == 'product'
    assign og_type = 'product'
  elsif request.page_type == 'article'
    assign og_type = 'article'
  elsif request.page_type == 'password'
    assign og_url = request.origin
  endif

  # Keep homepage metadata aligned with the public Send From China identity.
  if request.page_type == 'index'
    assign og_title = 'Send From China | Made in China. Select and Deliver.'
    assign og_description = 'Search and buy products from China, use guided product selection, or submit a targeted sourcing request. Agent access is available through structured catalog and account tools.'
  endif
%}

<meta
  property="og:site_name"
  content="{{ public_brand }}"
>
<meta
  property="og:url"
  content="{{ og_url }}"
>
<meta
  property="og:title"
  content="{{ og_title | escape }}"
>
<meta
  property="og:type"
  content="{{ og_type }}"
>
<meta
  property="og:description"
  content="{{ og_description | escape }}"
>

{%- if page_image -%}
  <meta
    property="og:image"
    content="http:{{ page_image | image_url }}"
  >
  <meta
    property="og:image:secure_url"
    content="https:{{ page_image | image_url }}"
  >
  <meta
    property="og:image:width"
    content="{{ page_image.width }}"
  >
  <meta
    property="og:image:height"
    content="{{ page_image.height }}"
  >
{%- endif -%}

{%- if request.page_type == 'product' -%}
  <meta
    property="og:price:amount"
    content="{{ product.price | money_without_currency | strip_html }}"
  >
  <meta
    property="og:price:currency"
    content="{{ cart.currency.iso_code }}"
  >
{%- endif -%}

{%- if settings.social_twitter_link != blank -%}
  <meta
    name="twitter:site"
    content="{{ settings.social_twitter_link | split: 'twitter.com/' | last | prepend: '@' }}"
  >
{%- endif -%}
<meta
  name="twitter:card"
  content="summary_large_image"
>
<meta
  name="twitter:title"
  content="{{ og_title | escape }}"
>
<meta
  name="twitter:description"
  content="{{ og_description | escape }}"
>

<title>
  {%- if request.page_type == 'index' -%}
    Send From China | Made in China. Select and Deliver.
  {%- else -%}
    {{ page_title }}
    {%- if current_tags %} &ndash; tagged "{{ current_tags | join: ', ' }}"{% endif -%}
    {%- if current_page != 1 %} &ndash; Page {{ current_page }}{% endif -%}
    {%- unless page_title contains public_brand %} &ndash; {{ public_brand }}{% endunless -%}
  {%- endif -%}
</title>

<link
  rel="canonical"
  href="{{ canonical_url }}"
>

{%- if request.page_type == 'index' -%}
  <meta name="description" content="{{ og_description | escape }}">
{%- elsif page_description -%}
  <meta name="description" content="{{ page_description | escape }}">
{%- endif -%}
