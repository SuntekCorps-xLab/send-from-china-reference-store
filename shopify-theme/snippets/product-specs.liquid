{% comment %}Category-aware specification template, version 2.{% endcomment %}

{% assign col_handles = product.collections | map: 'handle' %}

{% if col_handles contains 'edo-kiriko-glassware' %}
<div class="product-specs" style="margin-top:24px;padding:20px;background:#f9f7f4;border-radius:8px;">
  <h3 style="margin-bottom:12px;">Specifications</h3>
  <ul style="list-style:none;padding:0;line-height:2;">
    <li><strong>Material:</strong> K9 Crystal Glass, Lead-Free</li>
    <li><strong>Technique:</strong> Hand-cut using diamond wheel, 4-8 hours per piece</li>
    <li><strong>Style:</strong> Kiriko-inspired — crafted in Chinese crystal workshops using traditional diamond-wheel techniques, not certified Edo Kiriko</li>
    <li><strong>Origin:</strong> Crafted in established crystal cutting workshops, Shandong / Zhejiang Province, China</li>
    <li><strong>Glass Clarity:</strong> High transparency, strong light refraction through cut facets</li>
    <li><strong>Care:</strong> Hand wash only, store upright, avoid extreme temperature changes</li>
    <li><strong>Suitable for:</strong> Whiskey, sake, wine, cocktails, water — designed for daily use</li>
    {% if product.metafields.custom.material != blank %}
    <li><strong>Specific Material:</strong> {{ product.metafields.custom.material }}</li>
    {% endif %}
  </ul>
</div>

{% elsif col_handles contains 'wabi-sabi-ceramics' %}
<div class="product-specs" style="margin-top:24px;padding:20px;background:#f9f7f4;border-radius:8px;">
  <h3 style="margin-bottom:12px;">Specifications</h3>
  <ul style="list-style:none;padding:0;line-height:2;">
    <li><strong>Material:</strong> High-fired stoneware, food-safe glaze</li>
    <li><strong>Technique:</strong> Handmade with natural glaze variation — each piece is unique</li>
    <li><strong>Style:</strong> Wabi-sabi aesthetic, embracing natural imperfections</li>
    <li><strong>Production:</strong> Handmade in small-batch workshop production, not mass-manufactured</li>
    <li><strong>Origin:</strong> Crafted in traditional ceramic workshops, China</li>
    <li><strong>Durability:</strong> High-fired for daily use durability</li>
    <li><strong>Care:</strong> Dishwasher safe, microwave safe</li>
    <li><strong>Suitable for:</strong> Daily dining, serving, display, gifting</li>
  </ul>
</div>

{% elsif col_handles contains 'japanese-tea-sets' %}
<div class="product-specs" style="margin-top:24px;padding:20px;background:#f9f7f4;border-radius:8px;">
  <h3 style="margin-bottom:12px;">Specifications</h3>
  <ul style="list-style:none;padding:0;line-height:2;">
    <li><strong>Material:</strong> Ceramic / Porcelain, food-safe glaze</li>
    <li><strong>Technique:</strong> Hand-thrown or mold-formed, hand-finished</li>
    <li><strong>Heat Resistance:</strong> Safe for boiling water (100°C / 212°F)</li>
    <li><strong>Production:</strong> Workshop-made with hand-finishing, not fully automated</li>
    <li><strong>Origin:</strong> Crafted in Jingdezhen (Jiangxi) or Dehua (Fujian), China — both UNESCO-recognized porcelain production regions</li>
    <li><strong>Care:</strong> Hand wash recommended for hand-painted pieces, plain pieces are dishwasher safe</li>
    <li><strong>Best suited for:</strong> Gongfu tea (oolong, pu-erh), green tea, black tea, matcha</li>
    <li><strong>Brewing tip:</strong> Smaller cups (50-80ml) are ideal for gongfu style; larger cups (150-200ml) suit casual brewing</li>
  </ul>
</div>

