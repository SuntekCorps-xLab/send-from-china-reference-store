{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/send-from-china/reference-store-live-app-proxy-cases.v1.schema.json",
  "title": "Private read-only App Proxy acceptance cases",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "cases"],
  "properties": {
    "schema_version": { "const": "reference-store-live-app-proxy-cases/v1" },
    "cases": {
      "type": "array",
      "minItems": 10,
      "maxItems": 10,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["case_id", "query", "expected_handle"],
        "properties": {
          "case_id": { "type": "string", "pattern": "^case_[0-9a-f]{16,32}$" },
          "query": {
            "type": "string",
            "minLength": 2,
            "maxLength": 300,
            "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f\\u00ad\\u061c\\u180e\\u200b-\\u200f\\u202a-\\u202e\\u2060-\\u206f\\ufeff\\ufff9-\\ufffb]+$"
          },
          "expected_handle": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,99}$" }
        }
      }
    }
  }
}
